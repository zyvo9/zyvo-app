<?xml version="1.0" encoding="utf-8"?>
<!-- Tool row (Grok-style run box / file box).
     Header line (always): [icon] verb  +N -N  target            [chevron]
     Body (tap to open):
       shell  -> "Bash" label + copy, then  "$ command"  hairline  output
       write  -> file name label + copy, then numbered body (1 2 3)
       edit   -> file name label + copy, then washed line-numbered diff
     The body NEVER grows past ~40% of the screen: tool_scroll caps it and the
     rest scrolls INSIDE the card (bottom fade hints that more is below). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="12dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:id="@+id/tool_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/icon_box"
                android:layout_width="22dp"
                android:layout_height="22dp">

                <ImageView
                    android:id="@+id/tool_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_g_terminal"
                    android:tint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/tool_spinner"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_spinner_arc"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tool_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="Ran command"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tool_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="210dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/chevron"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lc_chevron_down"
                android:tint="@color/text_disabled"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tool_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/code_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code_card"
                android:orientation="horizontal">

                <View
                    android:id="@+id/code_edge"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/ok"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp">

                        <ImageView
                            android:id="@+id/code_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_g_terminal"
                            android:tint="@color/text_disabled" />

                        <TextView
                            android:id="@+id/code_lang"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="Bash"
                            android:textColor="@color/text_disabled"
                            android:textSize="11sp" />

                        <ImageButton
                            android:id="@+id/code_copy"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/copy"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_g_copy"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>

                    <!-- the actual "run box" line: $ command -->
                    <TextView
                        android:id="@+id/cmd_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginEnd="9dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_primary"
                        android:textIsSelectable="false"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/cmd_sep"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="9dp"
                        android:layout_marginEnd="9dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/line"
                        android:visibility="gone" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- fixed ~12-line editor box: line-number gutter pinned left,
                             code never wraps - long lines run to the right and the
                             box scrolls sideways, the body scrolls down. -->
                        <com.zyvo.code.MaxHeightScrollView
                            android:id="@+id/tool_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/code_gutter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:gravity="end"
                                    android:lineSpacingExtra="3dp"
                                    android:minWidth="30dp"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="7dp"
                                    android:textColor="@color/ok"
                                    android:textSize="11sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/gutter_sep"
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/line"
                                    android:visibility="gone" />

                                <HorizontalScrollView
                                    android:id="@+id/code_hscroll"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:overScrollMode="never"
                                    android:scrollbars="none">

                                    <TextView
                                        android:id="@+id/code_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="monospace"
                                        android:lineSpacingExtra="3dp"
                                        android:paddingStart="9dp"
                                        android:paddingEnd="14dp"
                                        android:paddingBottom="4dp"
                                        android:scrollHorizontally="true"
                                        android:textColor="@color/code_text"
                                        android:textColorHighlight="@color/select_blue"
                                        android:textIsSelectable="false"
                                        android:textSize="11sp" />
                                </HorizontalScrollView>
                            </LinearLayout>
                        </com.zyvo.code.MaxHeightScrollView>

                        <!-- soft fade: tells the eye there is more below (scroll only) -->
                        <View
                            android:id="@+id/body_fade"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_body_fade"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
