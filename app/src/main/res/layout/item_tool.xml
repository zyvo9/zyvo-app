<?xml version="1.0" encoding="utf-8"?>
<!-- Tool card (SS-30 design): one rounded container per tool.
     Header (icon + label + title + diff + chevron) sits INSIDE the card;
     body holds the command box ($ cmd, show-full toggle, output) for bash
     rows and the numbered diff/content for write/edit rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/tool_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tool_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/icon_box"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/tool_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lc_square_terminal"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tool_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="monospace"
                    android:text="⠋"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tool_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="Ran command"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tool_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/chevron"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lc_chevron_down"
                android:tint="@color/text_disabled"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tool_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/cmd_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cmd_box"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/cmd_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/cmd_full_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="Show full command ⌄"
                    android:textColor="@color/text_disabled"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/cmd_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tap_expand"
                    android:textColor="@color/text_disabled"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/expand_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tap_expand"
                android:textColor="@color/text_disabled"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/diff_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
