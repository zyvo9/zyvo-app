<?xml version="1.0" encoding="utf-8"?>
<!-- added-content panel: dark green wash + green left stripe (SS-26) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#141F2A14" />
        </shape>
    </item>
    <item android:width="3dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="10dp" android:bottomLeftRadius="10dp" />
            <solid android:color="#5C2EA043" />
        </shape>
    </item>
</layer-list>
